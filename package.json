{
  "name": "museum-platform",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "api:types": "openapi-typescript docs/api/openapi.yaml -o apps/web/src/generated/openapi.d.ts",
    "build": "pnpm api:types && pnpm --filter @museum/api build && pnpm --filter @museum/web build",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "start": "node scripts/docker-compose.mjs up --build",
    "stop": "node scripts/docker-compose.mjs down"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
